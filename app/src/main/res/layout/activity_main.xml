<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <TextView
                android:id="@+id/tvHello"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hello World!"
                android:textAlignment="center"
                android:textColor="@color/red"
                android:textSize="40sp"

                app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/step_logo"
                android:contentDescription="@string/company_log"

                app:layout_constraintTop_toBottomOf="@id/tvHello"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button"
                android:textSize="25sp"
                android:layout_margin="20dp"
                android:background="@drawable/btn_round_20_bg_red"
                app:backgroundTint="@null"

                app:layout_constraintTop_toBottomOf="@id/img_logo"
                />

            <TextView
                android:id="@+id/tvChooseSubjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_your_subjects"
                android:textSize="16sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"

                app:layout_constraintTop_toBottomOf="@id/btn"
                app:layout_constraintStart_toStartOf="parent"
                />

            <LinearLayout
                android:id="@+id/containerCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                app:layout_constraintTop_toBottomOf="@id/tvChooseSubjects"
                >
                <CheckBox
                    android:id="@+id/cbJava"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Java"
                    />

                <CheckBox
                    android:id="@+id/cbKotlin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kotlin"
                    android:layout_marginHorizontal="10dp"
                    />

                <CheckBox
                    android:id="@+id/cbCsharp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C#"
                    />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/containerRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                app:layout_constraintTop_toBottomOf="@id/containerCheckbox"
                >

                <RadioButton
                    android:id="@+id/rdMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Malse"
                    />

                <RadioButton
                    android:id="@+id/rdFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Female"
                    android:layout_marginStart="15dp"
                    />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etUsernameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Username"
                app:startIconDrawable="@drawable/username_24"

                app:layout_constraintTop_toBottomOf="@id/containerRadioButton"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etPwdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Password"
                app:startIconDrawable="@drawable/password_24"
                app:endIconDrawable="@drawable/password_toggle"
                app:endIconMode="password_toggle"

                app:layout_constraintTop_toBottomOf="@id/etUsernameLayout"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/et001"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Password"
                app:startIconDrawable="@drawable/password_24"
                app:endIconDrawable="@drawable/password_toggle"
                app:endIconMode="password_toggle"

                app:layout_constraintTop_toBottomOf="@id/etPwdLayout"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/et002"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Password"
                app:startIconDrawable="@drawable/password_24"
                app:endIconDrawable="@drawable/password_toggle"
                app:endIconMode="password_toggle"

                app:layout_constraintTop_toBottomOf="@id/et001"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:textSize="25sp"
                android:layout_margin="20dp"
                android:background="@drawable/bg_state_toggle"
                app:backgroundTint="@null"
                android:enabled="false"

                app:layout_constraintTop_toBottomOf="@id/et002"
                />

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/facebook"
                android:background="@drawable/btn_round"
                android:layout_marginStart="20dp"

                app:layout_constraintTop_toBottomOf="@id/btnSubmit"
                app:layout_constraintStart_toStartOf="parent"
                />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/google"
                style="@style/btn_round_bg_grey"

                app:layout_constraintTop_toTopOf="@id/btnFacebook"
                app:layout_constraintStart_toEndOf="@id/btnFacebook"
                android:layout_marginStart="50dp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>