<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PT16" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
    </style>

    <style name="Theme.PT16" parent="Base.Theme.PT16" />

    <style name="btn_round">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="btn_round_bg_grey">
        <item name="shapeAppearanceOverlay">@style/btn_round</item>
        <item name="android:background">#C0C0C0</item>
        <item name="strokeWidth">10dp</item>
        <item name="strokeColor">@color/grey</item>
    </style>

    <style name="AccessBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:background">@drawable/bg_badge_free</item>
    </style>

    <style name="AgeRatingBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/badge_age_rating</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:background">@drawable/bg_badge_pg13</item>
    </style>
</resources>
